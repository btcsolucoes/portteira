{
  "expo": {
    "name": "Portteira",
    "slug": "portteira",
    "version": "0.2.0",
    "scheme": "portteira",
    "icon": "./assets/portteira-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "name": "Portteira",
      "shortName": "Portteira",
      "description": "Explore o marketplace equestre Portteira. Prévia com anúncios de exemplo, favoritos e cadastro local.",
      "favicon": "./assets/portteira-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-image", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
