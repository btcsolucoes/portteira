{
  "name": "equestre",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "2.32.0",
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "start": "npm run start --workspace @equestre/mobile",
    "android": "npm run android --workspace @equestre/mobile",
    "ios": "npm run ios --workspace @equestre/mobile",
    "web": "npm run web --workspace @equestre/mobile",
    "export:pages": "node scripts/export-github-pages.cjs",
    "lint": "eslint apps/mobile packages/domain",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && node --test scripts/dependency-compat.test.cjs scripts/github-pages.test.cjs",
    "postinstall": "node scripts/patch-query-string.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
